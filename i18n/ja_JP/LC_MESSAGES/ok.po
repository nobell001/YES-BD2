msgstr "デイリー {day}：開始しませんでした"

msgid "日常 {day}：中途停了"
msgstr "デイリー {day}：途中で止まりました"

msgid "日常 {day}：{n} 项失败"
msgstr "デイリー {day}：{n} 件失敗"

msgid "日常 {day}：全部完成"
msgstr "デイリー {day}：すべて完了"

msgid "完成 {n} 项"
msgstr "完了 {n} 件"

