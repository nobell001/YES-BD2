msgstr "{n} 個の時間帯、クリックして設定"

msgid "电脑睡着时叫不醒：Windows 不让打开唤醒定时器"
msgstr "スリープ中は起こせません：Windows がウェイクタイマーを許可しません"

msgid "Windows 没有接受这个设定：{why}"
msgstr "Windows がこの設定を受け付けませんでした：{why}"

msgid "原因不明"
msgstr "原因不明"

