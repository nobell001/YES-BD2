msgstr "게임에서 한 번만 설정하면 됩니다"

msgid "微信通知"
msgstr "WeChat 알림"

msgid "跑图设定"
msgstr "파밍 준비"

msgid "跑图前，游戏里先设好这三样（{n}/3）"
msgstr "파밍 전에 게임에서 이 세 가지를 설정 ({n}/3)"

msgid "网络慢时的等待"
msgstr "네트워크가 느릴 때 대기"

msgid "打开游戏 {start} 秒 · 登录 {login} 秒"
msgstr "게임 실행 {start}초 · 로그인 {login}초"

msgid "网络或电脑慢、常常等到超时的话调大。默认值已经偏保守，一般不用改。"
msgstr "네트워크나 PC가 느려 자주 시간 초과가 나면 늘리세요. 기본값은 이미 넉넉해서 보통은 바꿀 필요가 없습니다."

msgid "{sub}（{low}–{high} {unit}，默认 {default}）"
msgstr "{sub} ({low}–{high} {unit}, 기본 {default})"

msgid "秒"
msgstr "초"

msgid "次"
msgstr "회"

msgid "打开游戏最长等多久"
msgstr "게임 실행 최대 대기 시간"

msgid "等游戏视窗出现、等到能截图，各自最多等这么久"
msgstr "게임 창이 뜨기까지, 화면을 캡처할 수 있기까지 각각 최대 이만큼 기다립니다"

msgid "打开游戏没好，再等几轮"
msgstr "게임이 준비되지 않으면 더 기다릴 횟수"

msgid "等太久时自动再等一轮，游戏开着就不会再开一次"
msgstr "시간 초과 시 한 번 더 기다리며, 게임이 이미 열려 있으면 다시 실행하지 않습니다"

msgid "登录后等主页最长多久"
msgstr "로그인 후 메인 화면 최대 대기 시간"

msgid "按了 TOUCH TO START 之后，最多等这么久进主页"
msgstr "TOUCH TO START를 누른 뒤 메인 화면까지 최대 이만큼 기다립니다"

msgid "登录没进主页，重试几次"
msgstr "메인 화면에 못 들어갈 때 재시도 횟수"

msgid "连续这么多次没进主页，就取消这次一键日常/周常"
msgstr "이 횟수만큼 연속으로 메인 화면에 못 들어가면 이번 일일/주간 일괄 실행을 취소합니다"
