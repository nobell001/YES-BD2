msgid "上面的阵形选哪个都可以"
msgstr "위의 진형은 아무거나 괜찮음"

msgid "下周{weekday} {time} 刷新"
msgstr "다음 주 {weekday}요일 {time} 초기화"

msgid "下周一 08:00 刷新"
msgstr "다음 주 월요일 08:00 초기화"

msgid "下次刷新 {next}"
msgstr "다음 초기화 {next}"

msgid "下次照它回放，更快更稳"
msgstr "다음에 그걸로 리플레이하면 더 빠르고 안정적"

msgid "不在一键日常里"
msgstr "일일 일괄 실행 제외"

msgid "不在一键运行里"
msgstr "일괄 실행 제외"

msgid "不支持的目标分辨率：{size}。"
msgstr "지원하지 않는 크기: {size}."

msgid "不是游戏官方的工具，跟游戏公司没有关系。"
msgstr "게임 공식 도구가 아니며, 게임사와 관련이 없습니다."

msgid "不调整（推荐，较稳定）"
msgstr "조정 안 함 (추천, 더 안정적)"

msgid "不跑"
msgstr "제외"

msgid "不限"
msgstr "제한 없음"

msgid "两个按钮都在「首页」。"
msgstr "두 버튼 모두 「홈」에 있습니다."

msgid "中途停了"
msgstr "도중에 중단됨"

msgid "主页卡带 → 末日之书 → 走到红色交叉剑标记 → 去战斗 → 跳过 → 离开 → 回主页（每周任务：参与末日之书）。战斗不消耗资源。走法跟镜中之战的「舞台移动方式」一样。"
msgstr "메인 화면 팩 → 종말의 서 → 빨간 교차 검 표시까지 이동 → 전투 → 건너뛰기 → 나가기 → 메인 화면 복귀(주간 퀘스트: 종말의 서 참여). 전투에 자원은 소모되지 않음. 이동 방식은 거울전쟁의 ‘무대 이동 방식’과 같음."

msgid "主页右侧活动横幅上的文字，逗号分隔，命中任意一个即点击。"
msgstr "메인 화면 오른쪽 이벤트 배너의 문구. 쉼표로 구분하며 하나라도 일치하면 클릭."

msgid "买"
msgstr "구매"

msgid "买什么、做哪些料理、每天卖什么都在那里设定"
msgstr "무엇을 살지, 어떤 요리를 할지, 매일 무엇을 팔지는 그곳에서 설정합니다"

msgid "二"
msgstr "화"

msgid "五"
msgstr "금"

msgid "交给桌面分身里的工具跑，进度在这里看"
msgstr "분신 데스크톱의 도구에 넘겼습니다. 진행 상황은 여기서 확인하세요"

msgid "仅使用免费活动AP"
msgstr "무료 이벤트 AP만 사용"

msgid "今天"
msgstr "오늘"

msgid "今天 {time}"
msgstr "오늘 {time}"

msgid "今天 · {n} 件"
msgstr "오늘 · {n}개"

msgid "今天卖 {n} 件"
msgstr "오늘 {n}개 판매"

msgid "今天已做"
msgstr "오늘 완료"

msgid "今天没做完"
msgstr "오늘 미완료"

msgid "今天没有要卖的"
msgstr "오늘 판매할 품목 없음"

msgid "今天的技能次数"
msgstr "오늘의 스킬 횟수"

msgid "今天的日常都做完了"
msgstr "오늘의 일일 항목 모두 완료"

msgid "今天的次数用完了"
msgstr "오늘 횟수를 모두 사용함"

msgid "今天跑了一部分"
msgstr "오늘 일부만 진행됨"

msgid "今天跑完了"
msgstr "오늘 진행 완료"

msgid "今天还没跑"
msgstr "오늘 아직 미진행"

msgid "今天还没跑过任务"
msgstr "오늘은 아직 실행한 작업이 없습니다"

msgid "今日任务"
msgstr "오늘의 항목"

msgid "今日报表"
msgstr "오늘 리포트"

msgid "今日日常"
msgstr "오늘의 일일"

msgid "从「{name}」继续"
msgstr "「{name}」부터 계속"

msgid "从主页进入公会，领取每日签到奖励。"
msgstr "메인 화면에서 길드에 들어가 일일 출석 보상을 수령."

msgid "从主页进入小屋，确认到达后返回主页。"
msgstr "메인 화면에서 마이홈에 들어가 도착을 확인한 뒤 메인 화면으로 복귀."

msgid "从快速切换页的生活玩法游戏卡带2号位进入梦幻广场并完成女神像许愿。"
msgstr "빠른 이동 화면의 콘텐츠팩 2번 슬롯으로 판타지아 스퀘어에 들어가 여신상 소원 빌기를 완료."

msgid "从首页进入快速狩猎，调度米饭并补充数量最少的属性圣石。"
msgstr "메인 화면에서 빠른 사냥에 들어가 쌀밥을 배분하고 가장 적은 속성의 성석을 보충."

msgid "任务奖励"
msgstr "퀘스트 보상"

msgid "任务正在运行，请先暂停任务再调整分辨率。"
msgstr "작업이 실행 중입니다. 크기를 바꾸기 전에 일시 정지하세요."

msgid "任务设定"
msgstr "작업 설정"

msgid "优先双倍"
msgstr "2배 우선"

msgid "会跳出 Windows 确认，请按「是」"
msgstr "Windows 확인 창이 뜨면 '예'를 누르세요"

msgid "使用说明"
msgstr "사용 안내"

msgid "使用须知"
msgstr "이용 안내"

msgid "例如：10月魔兽"
msgstr "예: 10월 마물"

msgid "依次打开左侧有红点的通行证，每张点一次全部获得（绝不点购买）。"
msgstr "왼쪽에 빨간 표시가 있는 패스를 차례로 열어 각각 모두 받기를 한 번만 누름(구매는 절대 누르지 않음)."

msgid "保存图片"
msgstr "이미지 저장"

msgid "做完的会跳过，没勾的不跑"
msgstr "끝난 항목은 건너뛰고, 체크 안 한 항목은 실행하지 않습니다"

msgid "做料理"
msgstr "요리하기"

msgid "停止"
msgstr "정지"

msgid "停止录制"
msgstr "기록 중지"

msgid "允许一键运行"
msgstr "일괄 실행 허용"

msgid "先在游戏的「服装顺序设置」排好每个角色的服装顺序！工具只排出手顺序和站位，召唤物的技能照存档选"
msgstr "먼저 게임의 「코스튬 순서 설정」에서 캐릭터마다 코스튬 순서를 정하세요! 도구는 행동 순서와 위치만 정하고, 소환수 스킬은 세이브대로 고릅니다"

msgid "先在游戏里把要买的商品加入收藏"
