msgstr "분신 데스크톱에 로그인하지 못했습니다. 왼쪽 「분신 데스크톱」 페이지의 「로그인 실패」를 보세요"

msgid "用过系统优化／精简工具或 RDP Wrapper 的电脑，可能不能用"
msgstr "시스템 최적화/경량화 도구나 RDP Wrapper를 쓴 PC는 안 될 수 있습니다"

msgid "登录帐户"
msgstr "로그인 계정"

msgid "第一次怎么用"
msgstr "처음 사용할 때"

msgid "被停用了"
msgstr "사용 안 함으로 되어 있음"

msgid "要 Windows 专业版；怎么设定看左边「桌面分身」页"
msgstr "Windows Pro 필요. 설정은 왼쪽 「분신 데스크톱」 페이지를 보세요"

msgid "要打的密码"
msgstr "입력할 비밀번호"

msgid "认不出是哪种帐户"
msgstr "계정 종류를 알 수 없음"

msgid "设定好后，回来这页看一次"
msgstr "설정 후 이 페이지를 다시 보세요"

msgid "请用「一键完成日常」"
msgstr "「일일 일괄 실행」을 쓰세요"

msgid "边跑边用电脑；进不去就照这页做"
msgstr "실행 중에도 PC를 쓸 수 있습니다. 들어가지 못하면 이 페이지대로 하세요"

msgid "还是不行"
msgstr "그래도 안 될 때"

msgid "还没设定"
msgstr "아직 설정 안 함"

msgid "这台电脑没有（精简版 Windows），不能用"
msgstr "이 PC에는 없습니다 (경량 Windows). 사용 불가"

msgid "这台电脑的开机密码，不是 PIN"
msgstr "이 PC의 로그인 비밀번호 (PIN 아님)"

msgid "这台电脑（自动检查）"
msgstr "이 PC (자동 확인)"

msgid "远程桌面服务"
msgstr "원격 데스크톱 서비스"

msgid "遇到问题（点开看做法）"
msgstr "문제가 생기면 (눌러서 방법 보기)"

